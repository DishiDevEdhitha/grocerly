# --- Required -------------------------------------------------------------
# Firebase service account key (Firestore database). Server-side only. How to get it: guide, Step 2.
# Paste the BASE64 text of the downloaded JSON key file (one single line).
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Optional -------------------------------------------------------------
# Enables AI-assisted ingredient explanations. Without it Grocerly still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Open Food Facts asks API users to identify their app. Put your own contact.
OFF_USER_AGENT=Grocerly/1.0 (student-project; your-email@example.com)
# Use https://in.openfoodfacts.org to bias search towards Indian products.
OFF_BASE_URL=https://world.openfoodfacts.org
